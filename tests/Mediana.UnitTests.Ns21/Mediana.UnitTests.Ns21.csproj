    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!-- Весь исходник UnitTests, исполненный против ns2.1-ассетов ядра -->
