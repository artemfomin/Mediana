<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Mediana ⇄ MassTransit: transport provider, dispatch bridge, MassTransit-envelope mode.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Mediana.MassTransit</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mediana.Transport.Abstractions\Mediana.Transport.Abstractions.csproj" />
    <ProjectReference Include="..\Mediana\Mediana.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="MassTransit" Version="8.5.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <PackageReference Include="MassTransit" />
  </ItemGroup>
</Project>
