<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Mediana RabbitMQ transport provider (net10.0: client 7.x; netstandard2.1: client 6.x).</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Mediana.RabbitMQ</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mediana.Transport.Abstractions\Mediana.Transport.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
</Project>
